            "args": [],
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build lab1-rasterization",
            "osx": {
                "MIMode": "lldb",
                "setupCommands": []
            },
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}/bin/lab1-rasterization.exe",
                "cwd": "${workspaceFolder}/bin",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "${workspaceFolder}/external/bin;${env:PATH}"
